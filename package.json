{
  "name": "break-my-workflow",
  "version": "0.1.3",
  "description": "A small local tool that tries to break n8n webhook workflows",
  "type": "module",
  "bin": {
    "break-workflow": "./break-my-workflow.mjs"
  },
  "files": [
    "break-my-workflow.mjs",
    "fault-mock.mjs",
    "fault-scenarios.json",
    "expectations.example.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "FSL-1.1-ALv2",
  "keywords": [
    "n8n",
    "chaos-engineering",
    "resilience-testing",
    "workflow-testing",
    "fault-injection"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node break-my-workflow.mjs analyze --workflow examples/demo-workflow.json",
    "analyze": "node break-my-workflow.mjs analyze",
    "generate": "node break-my-workflow.mjs generate",
    "run": "node break-my-workflow.mjs run",
    "assess": "node break-my-workflow.mjs assess",
    "trace": "node break-my-workflow.mjs trace",
    "collect": "node break-my-workflow.mjs collect",
    "report": "node break-my-workflow.mjs report",
    "mock": "node fault-mock.mjs",
    "test:cli": "node --test"
  }
}
